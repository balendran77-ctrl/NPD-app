# Copy this file to .env and fill in real values. Do NOT commit .env to source control.
MONGO_URI=
SESSION_SECRET=
AI_MODEL=gpt-4o

# If you plan to use OpenAI or similar, set your API key here (do NOT commit .env)
# OPENAI_API_KEY=

# Optionally enable model for all clients at runtime (set to 'gpt-5-mini' to switch)
# ENABLE_GPT5_MINI=false
