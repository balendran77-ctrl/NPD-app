<!DOCTYPE html>
<html>
<head>
    <title>Add Product</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/_nav') %>
    <div class="container">
    <h2>Add Product</h2>
    <form method="post" action="/add-product" class="form-card">
        <div><strong>Sl. No:</strong> (auto-generated after submission)</div>
        <input type="text" name="personName" placeholder="Person Entering Data" required><br>
        <input type="text" name="customerName" placeholder="Customer Name" required><br>
        <input type="text" name="productName" placeholder="Product Name" required><br>
        <h3>Specifications</h3>
        <div style="display:flex;gap:8px;">
            <input type="text" name="length" placeholder="Length" style="width: 80px;">
            <input type="text" name="width" placeholder="Width" style="width: 80px;">
            <input type="text" name="height" placeholder="Height" style="width: 80px;">
            <select name="unitOfMeasurement" style="width: 80px;">
                <option value="MM">MM</option>
                <option value="CM">CM</option>
                <option value="INCH">INCH</option>
            </select>
            </select>
        </div><br>
        <input type="text" name="ply" placeholder="Ply"><br>
        <input type="text" name="fluteType" placeholder="Flute type"><br>
        <input type="text" name="burstingStrength" placeholder="Bursting Strength"><br>
        <input type="text" name="BCT" placeholder="BCT"><br>
        <input type="text" name="ECT" placeholder="ECT"><br>
        <input type="text" name="FCT" placeholder="FCT"><br>
        <input type="text" name="moisture" placeholder="Moisture"><br>
        <input type="text" name="weight" placeholder="Weight"><br>
    <h3>Printing</h3>
        <input type="text" name="noOfColors" placeholder="No of Colors Printing"><br>
        <input type="text" name="printingType" placeholder="Type of Printing"><br>
        <input type="text" name="colorsToBePrinted" placeholder="Colors to be Printed"><br>
    <h3>Sample Details</h3>
    <label for="sampleType">Type of Sample <span class="required-star">*</span></label>
        <select name="sampleType" id="sampleType" required>
            <option value="">--Select--</option>
            <option value="FAI">FAI</option>
            <option value="Size and spec">Size and spec</option>
            <option value="Only size">Only size</option>
        </select><br>
        <label for="noOfSamples">No of Samples Required <span class="required-star">*</span></label>
        <input type="text" name="noOfSamples" id="noOfSamples" placeholder="No of Samples Required" required><br>
        <label for="requiredDate">Required Date <span class="required-star">*</span></label>
        <input type="date" name="requiredDate" id="requiredDate" placeholder="Required Date" required><br>
        <label for="deliveryAddress">Delivery Address <span class="required-star">*</span></label>
        <input type="text" name="deliveryAddress" id="deliveryAddress" placeholder="Delivery Address" required><br>
        <label for="customerContact">Customer Contact <span class="required-star">*</span></label>
        <input type="text" name="customerContact" id="customerContact" placeholder="Customer Contact" required><br>
        <label for="contactNo">Contact No <span class="required-star">*</span></label>
        <input type="text" name="contactNo" id="contactNo" placeholder="Contact No" required><br>
        <button type="submit">Add Product</button>
    </form>
    <div style="margin-top:12px;">
        <a href="/products">View Products</a> |
        <a href="/edit-specifications">Edit Specifications</a>
    </div>
    </div>
</body>
</html>
