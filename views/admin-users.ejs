<!DOCTYPE html>
<html>
<head>
    <title>Admin User Management</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <a href="/" class="header-link">Home</a>
    <h2>Admin User Management</h2>
    <form method="post" action="/admin/create-user" class="form-card">
        <label>Username:</label>
        <input type="text" name="username" required>
        <label>Password:</label>
        <input type="password" name="password" required>
        <label>Is Admin:</label>
        <select name="isAdmin">
            <option value="false">No</option>
            <option value="true">Yes</option>
        </select>
        <button type="submit">Create User</button>
    </form>
    <h3>Existing Users</h3>
    <table class="card" style="width:100%;border-collapse:collapse;">
        <thead>
            <tr><th>Username</th><th>Admin</th><th>Actions</th></tr>
        </thead>
        <tbody>
            <% users.forEach(function(user) { %>
                <tr>
                    <td><%= user.username %></td>
                    <td><%= user.isAdmin ? 'Yes' : 'No' %></td>
                    <td>
                        <form method="post" action="/admin/delete-user/<%= user._id %>" style="display:inline;">
                            <button type="submit" class="danger" onclick="return confirm('Delete user <%= user.username %>?')">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>
