<!DOCTYPE html>
<html>
<head>
    <title>ODS Report</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/styles.css">
    <style>
        .search-container {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            margin-bottom: 20px;
        }
        .search-form {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .search-form input {
            flex: 1;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            margin: 0;
        }
        .search-form button {
            padding: 10px 20px;
            background: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .search-results {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            margin-bottom: 20px;
        }
        .search-results table {
            width: 100%;
            border-collapse: collapse;
        }
        .search-results th,
        .search-results td {
            padding: 10px;
            border-bottom: 1px solid #eee;
            text-align: left;
        }
        .search-results th {
            background: #f8f9fa;
            font-weight: 600;
        }
        .search-results tr:hover {
            background: #f8f9fa;
        }
        .report-section {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            margin-bottom: 20px;
        }
        .report-section h3 {
            margin-top: 0;
            color: #333;
            border-bottom: 2px solid #007bff;
            padding-bottom: 10px;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }
        .info-item {
            padding: 10px;
            background: #f8f9fa;
            border-radius: 4px;
        }
        .info-label {
            font-weight: 600;
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 5px;
        }
        .info-value {
            color: #333;
            font-size: 1rem;
        }
        .ods-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        .ods-table th,
        .ods-table td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: left;
        }
        .ods-table th {
            background: #007bff;
            color: white;
        }
        .ods-table tr:nth-child(even) {
            background: #f8f9fa;
        }
        .layer-name {
            font-weight: 600;
            background: #e9ecef !important;
        }
        .btn-print {
            padding: 10px 20px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin-top: 10px;
        }
        .btn-print:hover {
            background: #218838;
        }
        @media print {
            .search-container, .search-results, nav, .btn-print {
                display: none;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/_nav') %>
    <div class="container">
        <h2>ODS Report</h2>
        
        <!-- Search Form -->
        <div class="search-container">
            <form method="get" action="/ods-report" class="search-form">
                <input type="text" name="q" placeholder="Search by Product Name, Customer Name, or SL No" value="<%= q %>" required>
                <button type="submit">🔍 Search</button>
            </form>
        </div>
        
        <!-- Search Results -->
        <% if (products && products.length > 0) { %>
            <div class="search-results">
                <h3>Search Results (<%= products.length %>)</h3>
                <table>
                    <thead>
                        <tr>
                            <th>SL No</th>
                            <th>Product Name</th>
                            <th>Customer Name</th>
                            <th>Ply</th>
                            <th>Created Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(function(p) { %>
                            <tr>
                                <td><%= p.slNo %></td>
                                <td><%= p.productName %></td>
                                <td><%= p.customerName %></td>
                                <td><%= p.specifications?.ply || 'N/A' %></td>
                                <td><%= new Date(p.createdAt).toLocaleDateString() %></td>
                                <td>
                                    <a href="/ods-report?id=<%= p._id %>" style="color: #007bff;">View Report</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else if (q && products.length === 0) { %>
            <div class="search-results">
                <p>No products found matching "<%= q %>"</p>
            </div>
        <% } %>
        
        <!-- Product Report -->
        <% if (product) { %>
            <button onclick="window.print()" class="btn-print">🖨️ Print Report</button>
            
            <!-- Product Specifications -->
            <div class="report-section">
                <h3>Product Specifications</h3>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">SL No</div>
                        <div class="info-value"><%= product.slNo %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Product Name</div>
                        <div class="info-value"><%= product.productName %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Customer Name</div>
                        <div class="info-value"><%= product.customerName %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Ply</div>
                        <div class="info-value"><%= product.specifications?.ply || 'N/A' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Flute Type</div>
                        <div class="info-value"><%= product.specifications?.fluteType || 'N/A' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Dimensions (L × W × H)</div>
                        <div class="info-value">
                            <%= product.specifications?.length || 'N/A' %> × 
                            <%= product.specifications?.width || 'N/A' %> × 
                            <%= product.specifications?.height || 'N/A' %> 
                            <%= product.specifications?.unitOfMeasurement || '' %>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Bursting Strength</div>
                        <div class="info-value"><%= product.specifications?.burstingStrength || 'N/A' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">BCT</div>
                        <div class="info-value"><%= product.specifications?.BCT || 'N/A' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">ECT</div>
                        <div class="info-value"><%= product.specifications?.ECT || 'N/A' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Sample Type</div>
                        <div class="info-value"><%= product.sampleType || 'N/A' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">No of Samples</div>
                        <div class="info-value"><%= product.noOfSamples || 'N/A' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Created Date</div>
                        <div class="info-value"><%= new Date(product.createdAt).toLocaleDateString() %></div>
                    </div>
                </div>
            </div>
            
            <!-- Printing Details -->
            <div class="report-section">
                <h3>Printing Details</h3>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">No of Colors</div>
                        <div class="info-value"><%= product.printing?.noOfColors || 'N/A' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Printing Type</div>
                        <div class="info-value"><%= product.printing?.type || 'N/A' %></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Colors to be Printed</div>
                        <div class="info-value"><%= product.printing?.colors || 'N/A' %></div>
                    </div>
                </div>
            </div>
            
            <!-- Order Data Sheet -->
            <% if (product.orderDataSheet && (product.orderDataSheet.layers?.length > 0 || product.orderDataSheet.reelSize || product.orderDataSheet.cuttingSize)) { %>
                <div class="report-section">
                    <h3>Order Data Sheet (ODS)</h3>
                    
                    <div class="info-grid">
                        <div class="info-item">
                            <div class="info-label">Reel Size (cm)</div>
                            <div class="info-value"><%= product.orderDataSheet.reelSize || 'N/A' %></div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Cutting Size (cm)</div>
                            <div class="info-value"><%= product.orderDataSheet.cuttingSize || 'N/A' %></div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Die No</div>
                            <div class="info-value"><%= product.orderDataSheet.dieNo || 'N/A' %></div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Die Cutting Board Reel Size (cm)</div>
                            <div class="info-value"><%= product.orderDataSheet.dieCuttingBoardReelSize || 'N/A' %></div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Die Cutting Board Cutting Size (cm)</div>
                            <div class="info-value"><%= product.orderDataSheet.dieCuttingBoardCuttingSize || 'N/A' %></div>
                        </div>
                    </div>
                    
                    <% if (product.orderDataSheet.layers && product.orderDataSheet.layers.length > 0) { %>
                        <h4 style="margin-top: 25px; margin-bottom: 10px;">Layer Details</h4>
                        <table class="ods-table">
                            <thead>
                                <tr>
                                    <th>Layer</th>
                                    <th>GSM</th>
                                    <th>BF</th>
                                    <th>Shade</th>
                                    <th>Mill</th>
                                    <th>Flute Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% product.orderDataSheet.layers.forEach(function(layer) { %>
                                    <tr>
                                        <td class="layer-name"><%= layer.name %></td>
                                        <td><%= layer.gsm || '-' %></td>
                                        <td><%= layer.bf || '-' %></td>
                                        <td><%= layer.shade || '-' %></td>
                                        <td><%= layer.mill || '-' %></td>
                                        <td><%= layer.fluteType || '-' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } %>
                    
                    <% if (product.orderDataSheet.processes && product.orderDataSheet.processes.length > 0) { %>
                        <h4 style="margin-top: 25px; margin-bottom: 10px;">Process Details</h4>
                        <table class="ods-table">
                            <thead>
                                <tr>
                                    <th>Process Name</th>
                                    <th>Machine</th>
                                    <th>Ups</th>
                                    <th>Joints</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% product.orderDataSheet.processes.forEach(function(process) { %>
                                    <tr>
                                        <td><%= process.name || '-' %></td>
                                        <td><%= process.machine || '-' %></td>
                                        <td><%= process.ups || '-' %></td>
                                        <td><%= process.joints || '-' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } %>
                </div>
            <% } else { %>
                <div class="report-section">
                    <h3>Order Data Sheet (ODS)</h3>
                    <p style="color: #999;">No Order Data Sheet information available for this product.</p>
                </div>
            <% } %>
            
            <button onclick="window.print()" class="btn-print">🖨️ Print Report</button>
        <% } %>
    </div>
</body>
</html>
