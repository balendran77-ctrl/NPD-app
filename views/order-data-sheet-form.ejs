<!DOCTYPE html>
<html>
<head>
    <title>Order Data Sheet - <%= product.productName %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
    body { font-family: Arial, sans-serif; background: #f9f9f9; margin: 0; padding: 0; }
    .container { max-width: 1000px; margin: 30px auto; background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.07); }
    h2 { text-align: center; margin-bottom: 10px; color: #333; }
    .product-info { background: #f8f9fa; padding: 15px; border-radius: 6px; margin-bottom: 30px; }
    .product-info p { margin: 5px 0; color: #555; }
    .product-info strong { color: #333; }
    
    /* Form Styles */
    form { margin-top: 20px; }
    label { display: block; font-weight: 600; margin-top: 15px; margin-bottom: 5px; color: #333; }
    
    /* Table Styles */
    .ods-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    .ods-table th { background: #007bff; color: white; padding: 12px; text-align: left; border: 1px solid #0056b3; }
    .ods-table td { padding: 10px; border: 1px solid #ddd; }
    .ods-table tr:nth-child(even) { background: #f8f9fa; }
    .ods-table input, .ods-table select { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
    .layer-name { font-weight: 600; color: #333; background: #e9ecef; }
    
    /* Buttons */
    .btn-container { margin-top: 30px; text-align: center; }
    .btn-save { padding: 12px 30px; background: #28a745; color: white; border: none; border-radius: 4px; font-size: 16px; cursor: pointer; }
    .btn-save:hover { background: #218838; }
    .btn-back { padding: 12px 30px; background: #6c757d; color: white; text-decoration: none; border-radius: 4px; font-size: 16px; display: inline-block; margin-left: 10px; }
    .btn-back:hover { background: #5a6268; }
    
    /* Info Box */
    .info-box { background: #d1ecf1; border-left: 4px solid #0c5460; padding: 15px; margin-bottom: 20px; border-radius: 4px; }
    .info-box p { margin: 5px 0; color: #0c5460; }
    
    /* Responsive */
    @media (max-width: 768px) {
        .container { margin: 10px; padding: 15px; }
        .ods-table { font-size: 14px; }
        .btn-container { display: flex; flex-direction: column; gap: 10px; }
        .btn-back { margin-left: 0; }
    }
    </style>
</head>
<body>
    <%- include('partials/_nav') %>
    <div class="container">
        <h2>Order Data Sheet (ODS)</h2>
        
        <!-- Product Information -->
        <div class="product-info">
            <p><strong>Product Name:</strong> <%= product.productName %></p>
            <p><strong>Customer Name:</strong> <%= product.customerName %></p>
            <p><strong>Ply:</strong> <%= ply %> Ply</p>
            <% if (product.specifications) { %>
                <p><strong>Dimensions:</strong> 
                    <%= product.specifications.length || 'N/A' %> × 
                    <%= product.specifications.width || 'N/A' %> × 
                    <%= product.specifications.height || 'N/A' %> 
                    <%= product.specifications.unitOfMeasurement || '' %>
                </p>
            <% } %>
        </div>
        
        <!-- Info Box -->
        <div class="info-box">
            <p><strong>Instructions:</strong></p>
            <p>• Fill in the details for each layer based on the <%= ply %>-ply box structure.</p>
            <p>• For <strong>Flute</strong> rows, select the flute type (B, C, or E).</p>
            <p>• GSM = Grams per Square Meter, BF = Bursting Factor</p>
        </div>
        
        <!-- ODS Form -->
        <form method="post" action="/order-data-sheet/<%= product._id %>">
            
            <h3 style="margin-top: 30px; margin-bottom: 15px; color: #333;">Layer Details</h3>
            <table class="ods-table">
                <thead>
                    <tr>
                        <th style="width: 20%;">Layer</th>
                        <th style="width: 15%;">GSM</th>
                        <th style="width: 15%;">BF</th>
                        <th style="width: 15%;">Shade</th>
                        <th style="width: 20%;">Mill</th>
                        <th style="width: 15%;">Flute Type</th>
                    </tr>
                </thead>
                <tbody>
                    <% product.orderDataSheet.layers.forEach(function(layer, index) { %>
                        <tr>
                            <td class="layer-name">
                                <%= layer.name %>
                                <input type="hidden" name="layerName" value="<%= layer.name %>">
                            </td>
                            <td>
                                <input type="text" name="gsm" value="<%= layer.gsm || '' %>" placeholder="e.g., 120">
                            </td>
                            <td>
                                <select name="bf">
                                    <option value="">-- Select BF --</option>
                                    <option value="12" <%= layer.bf === '12' ? 'selected' : '' %>>12</option>
                                    <option value="14" <%= layer.bf === '14' ? 'selected' : '' %>>14</option>
                                    <option value="16" <%= layer.bf === '16' ? 'selected' : '' %>>16</option>
                                    <option value="18" <%= layer.bf === '18' ? 'selected' : '' %>>18</option>
                                    <option value="20" <%= layer.bf === '20' ? 'selected' : '' %>>20</option>
                                    <option value="22" <%= layer.bf === '22' ? 'selected' : '' %>>22</option>
                                    <option value="24" <%= layer.bf === '24' ? 'selected' : '' %>>24</option>
                                    <option value="28" <%= layer.bf === '28' ? 'selected' : '' %>>28</option>
                                    <option value="32" <%= layer.bf === '32' ? 'selected' : '' %>>32</option>
                                    <option value="35" <%= layer.bf === '35' ? 'selected' : '' %>>35</option>
                                    <option value="40" <%= layer.bf === '40' ? 'selected' : '' %>>40</option>
                                    <option value="44" <%= layer.bf === '44' ? 'selected' : '' %>>44</option>
                                </select>
                            </td>
                            <td>
                                <input type="text" name="shade" list="shadeList<%= index %>" value="<%= layer.shade || '' %>" placeholder="Select or type shade">
                                <datalist id="shadeList<%= index %>">
                                    <option value="Natural">
                                    <option value="GYT">
                                    <option value="LGYT">
                                    <option value="NKLB">
                                    <option value="KLB">
                                    <option value="WKLB">
                                    <option value="WTL">
                                    <option value="HWC">
                                    <option value="LWC">
                                    <option value="VTKF">
                                    <option value="Whiteback">
                                    <option value="FM">
                                    <option value="TL">
                                    <option value="Pink">
                                </datalist>
                            </td>
                            <td>
                                <input type="text" name="mill" value="<%= layer.mill || '' %>" placeholder="e.g., Mill Name">
                            </td>
                            <td>
                                <% if (layer.name && layer.name.toLowerCase().includes('flute')) { %>
                                    <select name="fluteType">
                                        <option value="">-- Select --</option>
                                        <option value="B" <%= layer.fluteType === 'B' ? 'selected' : '' %>>B</option>
                                        <option value="C" <%= layer.fluteType === 'C' ? 'selected' : '' %>>C</option>
                                        <option value="E" <%= layer.fluteType === 'E' ? 'selected' : '' %>>E</option>
                                    </select>
                                <% } else { %>
                                    <input type="hidden" name="fluteType" value="">
                                    <span style="color: #999;">N/A</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
            
            <!-- Reel Size and Cutting Size (moved below Layers table) -->
            <div style="margin-top: 20px; margin-bottom: 10px; display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                <div>
                    <label for="reelSize">Reel Size:</label>
                    <input type="text" id="reelSize" name="reelSize" value="<%= product.orderDataSheet.reelSize || '' %>" placeholder="e.g., 1200mm" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                </div>
                <div>
                    <label for="cuttingSize">Cutting Size:</label>
                    <input type="text" id="cuttingSize" name="cuttingSize" value="<%= product.orderDataSheet.cuttingSize || '' %>" placeholder="e.g., 600mm" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                </div>
            </div>
            
            <!-- Processes Section -->
            <h3 style="margin-top: 40px; margin-bottom: 15px; color: #333;">Process Details</h3>
            <div style="margin-bottom: 15px;">
                <label for="numProcesses">Number of Processes:</label>
                <input type="number" id="numProcesses" min="1" max="10" value="<%= product.orderDataSheet.processes && product.orderDataSheet.processes.length > 0 ? product.orderDataSheet.processes.length : 1 %>" style="width: 150px; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                <button type="button" onclick="generateProcessRows()" style="padding: 8px 16px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; margin-left: 10px;">Generate Rows</button>
            </div>
            
            <table class="ods-table" id="processTable">
                <thead>
                    <tr>
                        <th style="width: 25%;">Process Name</th>
                        <th style="width: 25%;">Machine</th>
                        <th style="width: 25%;">Ups</th>
                        <th style="width: 25%;">Joints</th>
                    </tr>
                </thead>
                <tbody id="processTableBody">
                    <% if (product.orderDataSheet.processes && product.orderDataSheet.processes.length > 0) { %>
                        <% product.orderDataSheet.processes.forEach(function(process, index) { %>
                            <tr data-process="<%= process.name || '' %>">
                                <td>
                                    <select name="processName" class="process-select" onchange="handleProcessChange(this)" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                                        <option value="">-- Select Process --</option>
                                        <option value="Corrugation" <%= process.name === 'Corrugation' ? 'selected' : '' %>>Corrugation</option>
                                        <option value="Printer slotter" <%= process.name === 'Printer slotter' ? 'selected' : '' %>>Printer slotter</option>
                                        <option value="Die cutter" <%= process.name === 'Die cutter' ? 'selected' : '' %>>Die cutter</option>
                                        <option value="Folder gluer" <%= process.name === 'Folder gluer' ? 'selected' : '' %>>Folder gluer</option>
                                        <option value="Stitcher" <%= process.name === 'Stitcher' ? 'selected' : '' %>>Stitcher</option>
                                        <option value="Bundling" <%= process.name === 'Bundling' ? 'selected' : '' %>>Bundling</option>
                                        <option value="Flute laminator" <%= process.name === 'Flute laminator' ? 'selected' : '' %>>Flute laminator</option>
                                        <option value="Manual gluing" <%= process.name === 'Manual gluing' ? 'selected' : '' %>>Manual gluing</option>
                                        <option value="Assembly" <%= process.name === 'Assembly' ? 'selected' : '' %>>Assembly</option>
                                        <option value="Creasing" <%= process.name === 'Creasing' ? 'selected' : '' %>>Creasing</option>
                                        <option value="Slotting" <%= process.name === 'Slotting' ? 'selected' : '' %>>Slotting</option>
                                    </select>
                                </td>
                                <td><select name="machine" class="machine-select" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;"><option value="<%= process.machine || '' %>"><%= process.machine || '-- Select --' %></option></select></td>
                                <td><input type="text" name="ups" value="<%= process.ups || '' %>" placeholder="e.g., 2" class="ups-input"></td>
                                <td><input type="text" name="joints" value="<%= process.joints || '' %>" placeholder="e.g., 1" class="joints-input"></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr data-process="">
                            <td>
                                <select name="processName" class="process-select" onchange="handleProcessChange(this)" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                                    <option value="">-- Select Process --</option>
                                    <option value="Corrugation">Corrugation</option>
                                    <option value="Printer slotter">Printer slotter</option>
                                    <option value="Die cutter">Die cutter</option>
                                    <option value="Folder gluer">Folder gluer</option>
                                    <option value="Stitcher">Stitcher</option>
                                    <option value="Bundling" selected>Bundling</option>
                                    <option value="Flute laminator">Flute laminator</option>
                                    <option value="Manual gluing">Manual gluing</option>
                                    <option value="Assembly">Assembly</option>
                                    <option value="Creasing">Creasing</option>
                                    <option value="Slotting">Slotting</option>
                                </select>
                            </td>
                            <td><select name="machine" class="machine-select" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;"><option value="Bundling">Bundling</option></select></td>
                            <td><input type="text" name="ups" value="1" placeholder="e.g., 2" class="ups-input"></td>
                            <td><input type="text" name="joints" value="" placeholder="e.g., 1" class="joints-input"></td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
            
            <div style="margin-top: 20px; margin-bottom: 20px;">
                <label for="dieNo" style="display: inline-block; width: 150px; font-weight: bold;">Die No:</label>
                <input type="text" id="dieNo" name="dieNo" value="<%= product.orderDataSheet.dieNo || '' %>" placeholder="e.g., D123" style="width: 300px; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">
                <div>
                    <label for="dieCuttingBoardReelSize">Die cutting Board Reel size:</label>
                    <input type="text" id="dieCuttingBoardReelSize" name="dieCuttingBoardReelSize" value="<%= product.orderDataSheet.dieCuttingBoardReelSize || '' %>" placeholder="e.g., 1200mm" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                </div>
                <div>
                    <label for="dieCuttingBoardCuttingSize">Die cutting board cutting size:</label>
                    <input type="text" id="dieCuttingBoardCuttingSize" name="dieCuttingBoardCuttingSize" value="<%= product.orderDataSheet.dieCuttingBoardCuttingSize || '' %>" placeholder="e.g., 600mm" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;">
                </div>
            </div>
            
            <div class="btn-container">
                <button type="submit" class="btn-save">💾 Save Order Data Sheet</button>
                <a href="/order-data-sheet" class="btn-back">⬅ Back to Search</a>
            </div>
        </form>
        
        <script>
        function generateProcessRows() {
            const numProcesses = parseInt(document.getElementById('numProcesses').value) || 1;
            const tbody = document.getElementById('processTableBody');
            tbody.innerHTML = '';
            
            for (let i = 1; i <= numProcesses; i++) {
                const row = document.createElement('tr');
                const isLastRow = (i === numProcesses);
                row.setAttribute('data-process', '');
                
                row.innerHTML = `
                    <td>
                        <select name="processName" class="process-select" onchange="handleProcessChange(this)" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
                            <option value="">-- Select Process --</option>
                            <option value="Corrugation">Corrugation</option>
                            <option value="Printer slotter">Printer slotter</option>
                            <option value="Die cutter">Die cutter</option>
                            <option value="Folder gluer">Folder gluer</option>
                            <option value="Stitcher">Stitcher</option>
                            <option value="Bundling" ${isLastRow ? 'selected' : ''}>Bundling</option>
                            <option value="Flute laminator">Flute laminator</option>
                            <option value="Manual gluing">Manual gluing</option>
                            <option value="Assembly">Assembly</option>
                            <option value="Creasing">Creasing</option>
                            <option value="Slotting">Slotting</option>
                        </select>
                    </td>
                    <td><select name="machine" class="machine-select" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;"><option value="">-- Select --</option></select></td>
                    <td><input type="text" name="ups" value="${isLastRow ? '1' : ''}" placeholder="e.g., 2" class="ups-input"></td>
                    <td><input type="text" name="joints" value="" placeholder="e.g., 1" class="joints-input"></td>
                `;
                tbody.appendChild(row);
                
                // Initialize the ups/joints visibility for last row (bundling)
                if (isLastRow) {
                    const upsInput = row.querySelector('.ups-input');
                    const jointsInput = row.querySelector('.joints-input');
                    upsInput.readOnly = true;
                    upsInput.style.backgroundColor = '#f0f0f0';
                    
                    // Update machine dropdown for bundling
                    const machineSelect = row.querySelector('.machine-select');
                    updateMachineDropdown(machineSelect, 'Bundling');
                }
            }
            
            validateProcessDuplicates();
        }
        
        function handleProcessChange(selectElement) {
            const row = selectElement.closest('tr');
            const processName = selectElement.value;
            const upsInput = row.querySelector('.ups-input');
            const jointsInput = row.querySelector('.joints-input');
            const machineSelect = row.querySelector('.machine-select');
            
            // Update data-process attribute
            row.setAttribute('data-process', processName);
            
            // Update machine dropdown based on process
            updateMachineDropdown(machineSelect, processName);
            
            // Process names that require ups/joints input
            const processesWithUpsJoints = ['Corrugation', 'Printer slotter', 'Die cutter'];
            
            if (processesWithUpsJoints.includes(processName)) {
                // Enable ups/joints editing
                upsInput.readOnly = false;
                jointsInput.readOnly = false;
                upsInput.style.backgroundColor = '';
                jointsInput.style.backgroundColor = '';
                if (upsInput.value === '' || upsInput.value === '1') {
                    upsInput.value = '';
                }
            } else {
                // Default ups to 1, disable editing
                upsInput.value = '1';
                upsInput.readOnly = true;
                upsInput.style.backgroundColor = '#f0f0f0';
                jointsInput.readOnly = false;
                jointsInput.style.backgroundColor = '';
            }
            
            validateProcessDuplicates();
        }
        
        function updateMachineDropdown(machineSelect, processName) {
            if (!machineSelect) return;
            
            const currentValue = machineSelect.value;
            machineSelect.innerHTML = '';
            
            const machineOptions = {
                'Printer slotter': ['Printing 3', 'Printing 5', 'FFG'],
                'Die cutter': ['Auto Punching', 'Punching 1', 'Punching 2'],
                'Folder gluer': ['Folder gluer 1', 'Folder gluer 2', 'Folder gluer 3'],
                'Stitcher': ['Stitching 1', 'Stitching 2', 'Manual Stitching'],
                'Corrugation': ['Board plant', '2 ply Corrugator']
            };
            
            if (machineOptions[processName]) {
                // Add select prompt
                const defaultOption = document.createElement('option');
                defaultOption.value = '';
                defaultOption.textContent = '-- Select --';
                machineSelect.appendChild(defaultOption);
                
                // Add specific machine options
                machineOptions[processName].forEach(machine => {
                    const option = document.createElement('option');
                    option.value = machine;
                    option.textContent = machine;
                    if (machine === currentValue) {
                        option.selected = true;
                    }
                    machineSelect.appendChild(option);
                });
            } else if (processName) {
                // For other processes, use process name as machine name
                const option = document.createElement('option');
                option.value = processName;
                option.textContent = processName;
                option.selected = true;
                machineSelect.appendChild(option);
            } else {
                // Empty process
                const option = document.createElement('option');
                option.value = '';
                option.textContent = '-- Select --';
                machineSelect.appendChild(option);
            }
        }
        
        function validateProcessDuplicates() {
            const selects = document.querySelectorAll('.process-select');
            const selectedValues = [];
            const duplicates = [];
            
            selects.forEach((select, index) => {
                const value = select.value;
                if (value) {
                    if (selectedValues.includes(value)) {
                        duplicates.push(value);
                        select.style.borderColor = 'red';
                        select.style.backgroundColor = '#ffe6e6';
                    } else {
                        selectedValues.push(value);
                        select.style.borderColor = '#ccc';
                        select.style.backgroundColor = '';
                    }
                } else {
                    select.style.borderColor = '#ccc';
                    select.style.backgroundColor = '';
                }
            });
            
            // Show warning if duplicates exist
            const existingWarning = document.getElementById('duplicateWarning');
            if (existingWarning) {
                existingWarning.remove();
            }
            
            if (duplicates.length > 0) {
                const warning = document.createElement('div');
                warning.id = 'duplicateWarning';
                warning.style.cssText = 'color: #d9534f; background: #ffe6e6; padding: 10px; margin: 10px 0; border-radius: 4px; border: 1px solid #d9534f;';
                warning.innerHTML = `⚠️ Warning: Duplicate process names detected (${[...new Set(duplicates)].join(', ')}). Each process must be unique.`;
                const processTable = document.getElementById('processTable');
                processTable.parentNode.insertBefore(warning, processTable.nextSibling);
            }
        }
        
        // Validate on form submit
        document.querySelector('form').addEventListener('submit', function(e) {
            const selects = document.querySelectorAll('.process-select');
            const selectedValues = [];
            let hasDuplicates = false;
            
            selects.forEach(select => {
                const value = select.value;
                if (value && selectedValues.includes(value)) {
                    hasDuplicates = true;
                }
                if (value) {
                    selectedValues.push(value);
                }
            });
            
            if (hasDuplicates) {
                e.preventDefault();
                alert('Error: Duplicate process names detected. Each process must be unique.');
                return false;
            }
        });
        
        // Initialize validation on page load for existing processes
        document.addEventListener('DOMContentLoaded', function() {
            const selects = document.querySelectorAll('.process-select');
            selects.forEach(select => {
                if (select.value) {
                    const row = select.closest('tr');
                    const machineSelect = row.querySelector('.machine-select');
                    const currentMachine = machineSelect.value;
                    
                    // Update machine dropdown options
                    updateMachineDropdown(machineSelect, select.value);
                    
                    // Restore the saved machine value if it exists
                    if (currentMachine) {
                        machineSelect.value = currentMachine;
                    }
                    
                    handleProcessChange(select);
                }
            });
        });
        </script>
    </div>
</body>
</html>
