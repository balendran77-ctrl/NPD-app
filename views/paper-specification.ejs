<!DOCTYPE html>
<html>
<head>
    <title>Paper Specification</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/styles.css">
    <style>
        .spec-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }
        .spec-table th,
        .spec-table td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: left;
        }
        .spec-table th {
            background-color: #f0f0f0;
            font-weight: bold;
        }
        .spec-table input,
        .spec-table select {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        .ply-selector {
            margin: 20px 0;
        }
        .ply-selector label {
            display: inline-block;
            margin-right: 20px;
        }
        .add-custom {
            margin-top: 5px;
            font-size: 0.9rem;
        }
        .add-custom input {
            width: 200px;
            padding: 5px;
            margin-right: 5px;
        }
        .add-custom button {
            padding: 5px 10px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .history {
            margin-top: 30px;
            padding: 15px;
            background: #f9f9f9;
            border-radius: 4px;
        }
        .history h3 {
            margin-top: 0;
        }
        .history-item {
            padding: 8px 0;
            border-bottom: 1px solid #ddd;
        }
        .history-item:last-child {
            border-bottom: none;
        }
    </style>
</head>
<body>
    <%- include('partials/_nav') %>
    <div class="container">
        <h2>Paper Specification - <%= product.productName %></h2>
        <p><strong>Customer:</strong> <%= product.customerName %></p>
        
        <form action="/paper-specification/<%= product._id %>" method="POST" id="paperSpecForm">
            <div class="ply-selector">
                <label><strong>Ply:</strong></label>
                <select id="plySelect" name="ply" required onchange="updateLayers()">
                    <% for (let i = 1; i <= 7; i++) { %>
                        <option value="<%= i %>" <%= (paperSpec && paperSpec.ply === i) || (!paperSpec && product.specifications.ply == i) ? 'selected' : '' %>><%= i %>-Ply</option>
                    <% } %>
                </select>
            </div>

            <table class="spec-table" id="layersTable">
                <thead>
                    <tr>
                        <th style="width: 20%;">Layer</th>
                        <th style="width: 20%;">GSM</th>
                        <th style="width: 20%;">BF</th>
                        <th style="width: 20%;">Shade</th>
                        <th style="width: 20%;">Mill</th>
                    </tr>
                </thead>
                <tbody id="layersBody">
                    <!-- Dynamic rows will be inserted here -->
                </tbody>
            </table>

            <button type="submit">Save Paper Specification</button>
        </form>

        <% if (paperSpec && paperSpec.editHistory && paperSpec.editHistory.length > 0) { %>
            <div class="history">
                <h3>Edit History</h3>
                <% paperSpec.editHistory.slice().reverse().forEach(function(entry) { %>
                    <div class="history-item">
                        <strong><%= new Date(entry.editedAt).toLocaleString('en-IN') %></strong> - 
                        <%= entry.editedBy || 'Unknown' %>: 
                        <%= entry.changes %>
                    </div>
                <% }); %>
            </div>
        <% } %>

        <a href="/edit-specifications">Back to Product List</a>
    </div>

    <script>
        const gsmOptions = <%- JSON.stringify(gsmOptions) %>;
        const bfOptions = <%- JSON.stringify(bfOptions) %>;
        const shadeOptions = <%- JSON.stringify(shadeOptions) %>;
        const millOptions = <%- JSON.stringify(millOptions) %>;
        const existingSpec = <%- JSON.stringify(paperSpec) %>;

        const layerNames = {
            1: ['Top'],
            2: ['Top', 'Packing 1'],
            3: ['Top', 'Flute 1', 'Packing 1'],
            4: ['Top', 'Flute 1', 'Packing 1', 'Packing 2'],
            5: ['Top', 'Flute 1', 'Packing 1', 'Flute 2', 'Packing 2'],
            6: ['Top', 'Flute 1', 'Packing 1', 'Flute 2', 'Packing 2', 'Packing 3'],
            7: ['Top', 'Flute 1', 'Packing 1', 'Flute 2', 'Packing 2', 'Flute 3', 'Packing 3']
        };

        function createSelect(options, name, selectedValue) {
            let html = `<select name="layers[${name}]" required><option value="">Select...</option>`;
            options.forEach(opt => {
                const selected = opt.value === selectedValue ? 'selected' : '';
                html += `<option value="${opt.value}" ${selected}>${opt.value}</option>`;
            });
            html += `<option value="__custom__">+ Add Custom</option></select>`;
            html += `<div class="add-custom" style="display:none;"><input type="text" placeholder="Enter custom value"><button type="button" onclick="addCustomValue(this, '${name}')">Add</button></div>`;
            return html;
        }

        function updateLayers() {
            const ply = parseInt(document.getElementById('plySelect').value);
            const layersBody = document.getElementById('layersBody');
            const layers = layerNames[ply] || [];
            
            layersBody.innerHTML = '';
            
            layers.forEach((layerName, idx) => {
                const existingLayer = existingSpec && existingSpec.layers ? 
                    existingSpec.layers.find(l => l.layerName === layerName) : null;
                
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>
                        ${layerName}
                        <input type="hidden" name="layers[${idx}][layerName]" value="${layerName}">
                    </td>
                    <td>${createSelect(gsmOptions, `${idx}][gsm`, existingLayer ? existingLayer.gsm : '')}</td>
                    <td>${createSelect(bfOptions, `${idx}][bf`, existingLayer ? existingLayer.bf : '')}</td>
                    <td>${createSelect(shadeOptions, `${idx}][shade`, existingLayer ? existingLayer.shade : '')}</td>
                    <td>${createSelect(millOptions, `${idx}][mill`, existingLayer ? existingLayer.mill : '')}</td>
                `;
                layersBody.appendChild(row);
            });

            // Add event listeners for custom value selection
            document.querySelectorAll('.spec-table select').forEach(select => {
                select.addEventListener('change', function() {
                    const customDiv = this.nextElementSibling;
                    if (this.value === '__custom__' && customDiv) {
                        customDiv.style.display = 'block';
                        customDiv.querySelector('input').focus();
                    } else if (customDiv) {
                        customDiv.style.display = 'none';
                    }
                });
            });
        }

        function addCustomValue(button, fieldName) {
            const input = button.previousElementSibling;
            const customValue = input.value.trim();
            if (!customValue) {
                alert('Please enter a value');
                return;
            }
            
            const select = button.parentElement.previousElementSibling;
            const customOption = document.createElement('option');
            customOption.value = customValue;
            customOption.text = customValue;
            customOption.selected = true;
            select.insertBefore(customOption, select.lastElementChild);
            
            button.parentElement.style.display = 'none';
            input.value = '';
        }

        // Initialize on page load
        updateLayers();
    </script>
</body>
</html>
