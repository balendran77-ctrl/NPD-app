<style>
.main-nav {
    position: relative;
}
.dropdown {
    position: relative;
    display: inline-block;
}
.dropdown-content {
    display: none;
    position: absolute;
    background-color: #2c3e50;
    min-width: 200px;
    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
    z-index: 1;
    border-radius: 4px;
    margin-top: 2px;
}
.dropdown-content a {
    color: white;
    padding: 12px 16px;
    text-decoration: none;
    display: block;
    border-bottom: 1px solid #34495e;
}
.dropdown-content a:last-child {
    border-bottom: none;
}
.dropdown-content a:hover {
    background-color: #34495e;
}
.dropdown:hover .dropdown-content {
    display: block;
}
.dropdown > a {
    cursor: pointer;
}
</style>

<nav class="main-nav">
    <a href="/">Home</a>
    <% if (user) { %>
        <a href="/add-product">Add Product</a>
        <div class="dropdown">
            <a>Update ▾</a>
            <div class="dropdown-content">
                <a href="/quick-update">Update Status</a>
                <a href="/edit-specifications">Update Specifications</a>
                <a href="/order-data-sheet">Order Data Sheet</a>
            </div>
        </div>
        <div class="dropdown">
            <a>Reports ▾</a>
            <div class="dropdown-content">
                <a href="/report">Reports</a>
                <a href="/performance-report">Performance Report</a>
                <a href="/daily-updates">Daily Updates</a>
                <a href="/current-status">Current Status</a>
            </div>
        </div>
        <% if (user && user.isAdmin) { %>
            <a href="/admin/users">Admin</a>
            <a href="/admin/ai-settings">AI Settings</a>
        <% } %>
        <a href="/logout" class="right">Logout</a>
    <% } else { %>
        <a href="/login" class="right">Login</a>
    <% } %>
</nav>
