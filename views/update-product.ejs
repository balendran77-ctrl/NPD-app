<!DOCTYPE html>
<html>
<head>
    <title>Update Delivery/Approval</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include('partials/_nav') %>
    <div class="container">
    <h2>Update Delivery/Approval for <%= product.productName %></h2>
    <form method="post" action="/update-product/<%= product._id %>" class="form-card">
        <label>Delivered Date:</label>
        <input type="date" name="deliveredDate" value="<%= product.deliveredDate %>"><br>
        <label for="dcDetails">DC Details:</label>
        <input type="text" id="dcDetails" name="dcDetails" value="<%= product.dcDetails || '' %>"><br>
        <label for="courierDetails">Courier Details:</label>
        <input type="text" id="courierDetails" name="courierDetails" value="<%= product.courierDetails || '' %>"><br>
        <label>Approved Date:</label>
        <input type="date" name="approvedDate" value="<%= product.approvedDate %>"><br>
        <label>Approval Status:</label>
        <select name="approvalStatus">
            <option value="" <%= !product.approvalStatus ? 'selected' : '' %> >-- Select status --</option>
            <option value="Approved" <%= product.approvalStatus === 'Approved' ? 'selected' : '' %>>Approved</option>
            <option value="Rejected" <%= product.approvalStatus === 'Rejected' ? 'selected' : '' %>>Rejected</option>
            <option value="Resample" <%= product.approvalStatus === 'Resample' ? 'selected' : '' %>>Resample</option>
            <option value="HOLD" <%= product.approvalStatus === 'HOLD' ? 'selected' : '' %>>HOLD</option>
            <option value="Cancelled" <%= product.approvalStatus === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select><br>
        <div id="orderFields" style="display:<%= product.approvalStatus === 'Approved' ? 'block' : 'none' %>;margin-top:10px;padding:10px;border:1px solid #ddd;border-radius:4px;">
            <h4>Order Details (on approval)</h4>
            <label>Order Quantity:</label>
            <input type="number" name="orderQuantity" value="<%= product.orderQuantity || '' %>"><br>
            <label>Order Value:</label>
            <input type="number" step="0.01" name="orderValue" value="<%= product.orderValue || '' %>"><br>

            <h4>Sampling Costs</h4>
            <div class="grid-2">
                <div>
                    <label>Stereo Cost:</label>
                    <input type="number" step="0.01" name="stereoCost" value="<%= (product.sampleCosts && product.sampleCosts.stereoCost) || 0 %>">
                </div>
                <div>
                    <label>Die Cost:</label>
                    <input type="number" step="0.01" name="dieCost" value="<%= (product.sampleCosts && product.sampleCosts.dieCost) || 0 %>">
                </div>
                <div>
                    <label>Board Cost:</label>
                    <input type="number" step="0.01" name="boardCost" value="<%= (product.sampleCosts && product.sampleCosts.boardCost) || 0 %>">
                </div>
                <div>
                    <label>Printing Cost:</label>
                    <input type="number" step="0.01" name="printingCost" value="<%= (product.sampleCosts && product.sampleCosts.printingCost) || 0 %>">
                </div>
                <div>
                    <label>Manhour Cost:</label>
                    <input type="number" step="0.01" name="manhourCost" value="<%= (product.sampleCosts && product.sampleCosts.manhourCost) || 0 %>">
                </div>
                <div>
                    <label>Courier Cost:</label>
                    <input type="number" step="0.01" name="courierCost" value="<%= (product.sampleCosts && product.sampleCosts.courierCost) || 0 %>">
                </div>
            </div>
            <p style="margin-top:8px;color:#333;">Total Sample Cost: <strong><%= (product.sampleCosts && product.sampleCosts.totalSampleCost) || 0 %></strong></p>
        </div>
        <label>Rejection Reason:</label>
        <input type="text" name="rejectionReason" value="<%= product.rejectionReason %>"><br>

    <hr>
    <h3>Status Update</h3>
        <label for="statusDate">Status as on Date:</label>
        <input type="date" id="statusDate" name="statusDate"><br>
        <label for="status">Status:</label>
        <input type="text" id="status" name="status"><br>
        <label for="statusDetails">Status change details:</label>
        <textarea id="statusDetails" name="statusDetails" rows="2"></textarea><br>
        <button type="submit">Update</button>
    </form>
    <div style="margin-top:12px;">
        <a href="/products">Back to Products</a> |
        <a href="/edit-specifications">Edit Specifications</a>
    </div>
        <script>
        (function(){
            const statusSelect=document.querySelector('select[name="approvalStatus"]');
            const orderFields=document.getElementById('orderFields');
            statusSelect.addEventListener('change',()=>{
                if(statusSelect.value==='Approved'){orderFields.style.display='block';}else{orderFields.style.display='none';}
            });
        })();
        </script>
    </div>
</body>
</html>
