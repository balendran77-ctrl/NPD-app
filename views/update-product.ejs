<!DOCTYPE html>
<html>
<head>
    <title>Update Delivery/Approval</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
    <a href="/" class="header-link">Home</a>
    <h2>Update Delivery/Approval for <%= product.productName %></h2>
    <form method="post" action="/update-product/<%= product._id %>" class="form-card">
        <label>Delivered Date:</label>
        <input type="date" name="deliveredDate" value="<%= product.deliveredDate %>"><br>
        <label for="dcDetails">DC Details:</label>
        <input type="text" id="dcDetails" name="dcDetails" value="<%= product.dcDetails || '' %>"><br>
        <label for="courierDetails">Courier Details:</label>
        <input type="text" id="courierDetails" name="courierDetails" value="<%= product.courierDetails || '' %>"><br>
        <label>Approved Date:</label>
        <input type="date" name="approvedDate" value="<%= product.approvedDate %>"><br>
        <label>Approval Status:</label>
        <select name="approvalStatus">
            <option value="" <%= !product.approvalStatus ? 'selected' : '' %> >-- Select status --</option>
            <option value="Approved" <%= product.approvalStatus === 'Approved' ? 'selected' : '' %>>Approved</option>
            <option value="Rejected" <%= product.approvalStatus === 'Rejected' ? 'selected' : '' %>>Rejected</option>
            <option value="Resample" <%= product.approvalStatus === 'Resample' ? 'selected' : '' %>>Resample</option>
            <option value="HOLD" <%= product.approvalStatus === 'HOLD' ? 'selected' : '' %>>HOLD</option>
            <option value="Cancelled" <%= product.approvalStatus === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select><br>
        <label>Rejection Reason:</label>
        <input type="text" name="rejectionReason" value="<%= product.rejectionReason %>"><br>

    <hr>
    <h3>Status Update</h3>
        <label for="statusDate">Status as on Date:</label>
        <input type="date" id="statusDate" name="statusDate"><br>
        <label for="status">Status:</label>
        <input type="text" id="status" name="status"><br>
        <label for="statusDetails">Status change details:</label>
        <textarea id="statusDetails" name="statusDetails" rows="2"></textarea><br>
        <button type="submit">Update</button>
    </form>
    <div style="margin-top:12px;">
        <a href="/products">Back to Products</a> |
        <a href="/edit-specifications">Edit Specifications</a>
    </div>
    </div>
</body>
</html>
